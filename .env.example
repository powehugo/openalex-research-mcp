# Optional: Your email for better rate limits (polite pool)
OPENALEX_EMAIL=your.email@example.com

# Optional: API key for premium access
# OPENALEX_API_KEY=your-api-key-here
# Several keys (comma/newline separated). Each key has its own daily allowance;
# a key that is out of budget is skipped until 00:00 UTC, an invalid key is dropped.
# OPENALEX_API_KEYS=key-one,key-two,key-three

# Optional external-source configuration (never commit real secrets)
# S2_API_KEY=your-semantic-scholar-api-key
# MCP_BEARER_TOKEN=generate-a-long-random-secret
# CROSSREF_MAILTO=your.email@example.com
# DATA_GOV_API_KEY=your-api-data-gov-key

# HTTP MCP deployment
# MCP_TRANSPORT_TYPE=streamable-http
# MCP_HTTP_ENDPOINT_PATH=/mcp
# PORT=3000

# Google Scholar via SerpApi (each search spends one SerpApi credit).
# Several keys, comma/newline separated; used in order, rotated when one is out of searches or rate-limited.
# SERPAPI_API_KEYS=key-one,key-two

# Semantic Scholar: several keys spread requests (each key ~1 request/second).
# S2_API_KEYS=key-one,key-two   (S2_API_KEY still works and is merged in)
